{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "python -m jobs.validate_runtime --service web"
    ],
    "startCommand": "python -u -m jobs.validate_company_memory_live --tickers SPR --auto 3 --minimum-history 2 --output company-memory-live-validation.json",
    "restartPolicyType": "NEVER"
  }
}
