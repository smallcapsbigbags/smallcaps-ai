# Railway PostgreSQL connection. Local development may use SQLite.
DATABASE_URL=sqlite+pysqlite:///data/smallcaps.db

# OpenAI evidence retrieval and analyst engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DEEP_MODEL=gpt-5.4
OPENAI_MAX_OUTPUT_TOKENS=12000

# Optional local/one-off benchmark override. Railway production always records
# the prompt version shipped in analyst/version.py, so stale service variables
# cannot mislabel live output.
PROMPT_VERSION=analyst-engine-3.4-facts-no-fluff-routing

# AIM discovery policy.
#
# disabled   = fail closed; no new announcements are discovered.
# licensed   = production/launch mode using AIM_LICENSED_FEED_URL.
# owner-test = private-beta continuity only. It uses private-investor web
#              catalogues and is blocked unless the explicit acknowledgement
#              below is true. Do not use owner-test for public/commercial launch.
AIM_DISCOVERY_MODE=disabled
AIM_LICENSED_FEED_URL=
AIM_LICENSED_FEED_TOKEN=
AIM_LICENSED_FEED_TIMEOUT_SECONDS=30
ALLOW_UNLICENSED_OWNER_TEST_CATALOGUES=false

# Evidence retrieval and ingestion limits.
DEEP_SEARCH_BATCH_SIZE=5
MAX_DOCUMENT_CHARS=45000
MIN_EVIDENCE_CHARS=40
INVESTEGATE_AIM_MAX_PAGES=8
MAX_AI_ITEMS=36

# Private beta and Analyst QA.
PRIVATE_BETA_MODE=true
APP_BETA_PASSWORD=
APP_ADMIN_PASSWORD=

# Public product and market reaction.
MARKET_DATA_ENABLED=true
MARKET_DATA_TIMEOUT_SECONDS=25
DEFAULT_WATCHLIST=
