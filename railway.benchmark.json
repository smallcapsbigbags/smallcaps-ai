{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "python -m jobs.validate_runtime --service benchmark"
    ],
    "startCommand": "python -u -m jobs.run_gold_standard_benchmark",
    "restartPolicyType": "NEVER"
  }
}
