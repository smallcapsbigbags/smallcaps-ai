{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "python -m jobs.validate_runtime --service ingestion --create-schema"
    ],
    "startCommand": "python -m jobs.ingest_daily",
    "cronSchedule": "*/10 6-18 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
