{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "python -m jobs.validate_runtime --service prices --create-schema",
      "python -m jobs.audit_production --service prices --record"
    ],
    "startCommand": "python -m jobs.update_prices",
    "cronSchedule": "*/15 7-17 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
